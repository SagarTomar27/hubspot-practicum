doctype html
html
  head
    title= title
    style.
      body { font-family: Arial, sans-serif; margin: 40px; }
      table { border-collapse: collapse; width: 100%; }
      th, td { border: 1px solid #ccc; padding: 10px; text-align: left; }
      th { background: #ff7a59; color: white; }
      a.btn { display: inline-block; margin-top: 20px; padding: 10px 16px; background: #ff7a59; color: white; text-decoration: none; border-radius: 4px; }
  body
    h1 SMS Campaigns
    table
      thead
        tr
          th Campaign Name
          th Description
          th Status
      tbody
        each record in data
          tr
            td= record.properties[props[0]]
            td= record.properties[props[1]]
            td= record.properties[props[2]]
    a.btn(href="/update-cobj") Add a new campaign
