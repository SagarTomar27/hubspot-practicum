doctype html
html
  head
    title= title
    style.
      body { font-family: Arial, sans-serif; margin: 40px; }
      label { display: block; margin-top: 14px; font-weight: bold; }
      input { width: 320px; padding: 8px; margin-top: 4px; }
      button { margin-top: 20px; padding: 10px 16px; background: #ff7a59; color: white; border: none; border-radius: 4px; cursor: pointer; }
  body
    h1 Update Custom Object Form
    form(action="/update-cobj" method="POST")
      label(for="name") Campaign Name
      input(type="text" id="name" name="name" required)
      label(for="description") Description
      input(type="text" id="description" name="description")
      label(for="status") Status
      input(type="text" id="status" name="status")
      button(type="submit") Submit
    p
      a(href="/") Return to the homepage
